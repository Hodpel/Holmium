# Required when running Holmium with the Notion data source.
NOTION_PAGE_ID=

# Optional. Set this when the Notion page is not public.
NOTION_ACCESS_TOKEN=

# Optional server-side Notion host. Do not include a protocol or trailing slash.
NOTION_HOST=www.notion.so

# Optional public host used by browser-rendered Notion icons.
# Keep it aligned with NOTION_HOST when using a custom Notion-compatible host.
NEXT_PUBLIC_NOTION_HOST=www.notion.so
